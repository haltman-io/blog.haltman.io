{
  "name": "blog.haltman.io",
  "version": "1.0.0",
  "description": "A production-ready, backend-free Next.js MDX blog template for static and hosted deployments.",
  "type": "module",
  "private": true,
  "license": "Unlicense",
  "author": "Haltman.IO <root@haltman.io> (https://haltman.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haltman-io/blog.haltman.io.git"
  },
  "bugs": {
    "url": "https://github.com/haltman-io/blog.haltman.io/issues"
  },
  "homepage": "https://github.com/haltman-io/blog.haltman.io#readme",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "mdx",
    "static-blog",
    "frontmatter",
    "seo",
    "shadcn",
    "basecn",
    "template"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:static": "cross-env NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,mdx,json,mjs}\"",
    "validate": "npm run check && npm run build && npm run build:static",
    "serve:static": "npx --yes serve@latest out",
    "preview:static": "npm run build:static && npm run serve:static",
    "deploy:vercel": "npx --yes vercel",
    "deploy:vercel:prod": "npx --yes vercel --prod",
    "deploy:cloudflare": "npm run build:static && npx --yes wrangler pages deploy out --project-name blog-haltman-io",
    "deploy:netlify": "npm run build:static && npx --yes --package=netlify-cli netlify deploy --dir=out",
    "deploy:netlify:prod": "npm run build:static && npx --yes --package=netlify-cli netlify deploy --prod --dir=out"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
